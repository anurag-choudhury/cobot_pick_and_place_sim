<sdf version="1.9">
  <model name="aruco_cube">
    <static>false</static>

    <!-- Place cube on ground: center at z=0.1 for a 0.2m cube -->
    <pose>0 0 0.1 0 0 0</pose>

    <link name="cube_link">

      <collision name="cube_collision">
        <geometry>
          <box>
            <size>0.2 0.2 0.2</size>
          </box>
        </geometry>
      </collision>

      <visual name="cube_visual">
        <geometry>
          <box>
            <size>0.2 0.2 0.2</size>
          </box>
        </geometry>
        <material>
          <ambient>0.7 0.7 0.7 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
        </material>
      </visual>

      <visual name="aruco_marker_visual">
        <!-- lift a bit more to avoid z-fighting -->
        <pose>0 0 0.102 0 0 0</pose>

        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.198 0.198</size>
          </plane>
        </geometry>

        <cast_shadows>false</cast_shadows>


       <material>
  <ambient>1 1 1 1</ambient>
  <diffuse>1 1 1 1</diffuse>
  <emissive>0 0 0 1</emissive>

  <pbr>
    <metal>
      <albedo>1 1 1</albedo>
      <roughness>1.0</roughness>
      <metalness>0.0</metalness>
      <albedo_map>model://aruco_cube/materials/textures/aruco.png</albedo_map>
    </metal>
  </pbr>
</material>

      </visual>

      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.003333</ixx>
          <iyy>0.003333</iyy>
          <izz>0.003333</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

    </link>
  </model>
</sdf>
